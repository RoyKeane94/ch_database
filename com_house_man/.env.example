# Required in production (DEBUG=False)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=your-app.up.railway.app,www.example.com
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Database — use DATABASE_URL (Railway/Heroku) or individual vars
DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_PORT=5432

# Optional
DEBUG=False
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
