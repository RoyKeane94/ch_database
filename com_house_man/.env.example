# Required in production (DEBUG=False)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Optional on Railway — RAILWAY_PUBLIC_DOMAIN is added automatically
ALLOWED_HOSTS=www.example.com

# Database — use either DATABASE_URL or individual vars (both work)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=autorack.proxy.rlwy.net
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-password
DB_PORT=5432

# On Railway you can instead reference Postgres vars: PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE

# Optional
DEBUG=False
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
